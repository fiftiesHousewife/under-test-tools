<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Based on the rules bundled in the io.github.fiftieshousewife.cleancode plugin, with every finding an error
  and the standards in AGENTS.md added:
  - no more than three parameters for any method or constructor (use a Lombok @Builder instead);
  - no more than three components in a record (use a Lombok @Builder class instead of a large record);
  - complexity limits.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="NeedBraces"/>
        <module name="EmptyBlock"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FinalLocalVariable"/>
        <module name="ParameterNumber">
            <property name="max" value="3"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
        </module>
        <module name="RecordComponentNumber">
            <property name="max" value="3"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="200"/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="max" value="3"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="MethodLength|ParameterNumber"/>
            <property name="query" value="//METHOD_DEF[./IDENT[@text='equals' or @text='hashCode']]"/>
        </module>
    </module>
    <module name="FileLength">
        <property name="max" value="300"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>
</module>
