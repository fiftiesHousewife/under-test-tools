<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Based on the rules bundled in the io.github.fiftieshousewife.cleancode plugin, with every finding an error
  and the standards in AGENTS.md added:
  - no more than three parameters for any method or constructor (use a Lombok @Builder instead);
  - no more than three components in a record (use a Lombok @Builder class instead of a large record);
  - complexity limits;
  - Javadoc only on a public type, and on a public member of one;
  - no comment on a field: a field's name says what it is, and what needs saying goes on the class or method;
  - no method longer than 20 lines, not counting blank ones, and no file longer than 150 lines.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="NeedBraces"/>
        <module name="EmptyBlock"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FinalLocalVariable"/>
        <module name="ParameterNumber">
            <property name="max" value="3"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
        </module>
        <module name="RecordComponentNumber">
            <property name="max" value="3"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="6"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="50"/>
        </module>
        <module name="BooleanExpressionComplexity">
            <property name="max" value="3"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="20"/>
            <property name="countEmpty" value="false"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF"/>
        </module>
        <module name="MatchXpath">
            <property name="query" value="//OBJBLOCK/VARIABLE_DEF[MODIFIERS//BLOCK_COMMENT_BEGIN
                or MODIFIERS//SINGLE_LINE_COMMENT or TYPE//BLOCK_COMMENT_BEGIN or TYPE//SINGLE_LINE_COMMENT]"/>
            <message key="matchxpath.match"
                value="A field has no comment: name it so it needs none, or say it on the class or method."/>
        </module>
        <module name="MatchXpath">
            <property name="id" value="JavadocOnlyWhenPublic"/>
            <property name="query" value="//*[self::CLASS_DEF or self::INTERFACE_DEF or self::ENUM_DEF or self::RECORD_DEF or self::ANNOTATION_DEF or self::METHOD_DEF or self::CTOR_DEF or self::COMPACT_CTOR_DEF][./*[not(self::OBJBLOCK or self::SLIST)]//BLOCK_COMMENT_BEGIN[starts-with(COMMENT_CONTENT/@text, '*')]][not(MODIFIERS/LITERAL_PUBLIC or parent::OBJBLOCK/parent::INTERFACE_DEF) or ancestor::*[self::CLASS_DEF or self::INTERFACE_DEF or self::ENUM_DEF or self::RECORD_DEF or self::ANNOTATION_DEF][not(MODIFIERS/LITERAL_PUBLIC or parent::OBJBLOCK/parent::INTERFACE_DEF)]]"/>
            <message key="matchxpath.match"
                value="Javadoc goes only on a public type and its public members: say it in a // comment, or not at all."/>
        </module>
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="MethodLength|ParameterNumber"/>
            <property name="query" value="//METHOD_DEF[./IDENT[@text='equals' or @text='hashCode']]"/>
        </module>
    </module>
    <module name="FileLength">
        <property name="max" value="150"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>
</module>
